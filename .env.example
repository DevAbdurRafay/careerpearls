# ═════════════════════════════════════════════════════════════════
# CareerPearls — Environment Configuration Example (.env)
# ═════════════════════════════════════════════════════════════════

# --- Flask & Core App ---
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_SECRET_KEY=your-super-secret-key-change-this-in-production
APP_BASE_URL=http://localhost:5000

# --- Database ---
DATABASE_URL=sqlite:///careerpearls.db

# --- Google OAuth Credentials (Login with Google) ---
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Email / SMTP Settings (Gmail App Password) ---
# Get 16-character App Password from: https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-gmail-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ═════════════════════════════════════════════════════════════════
# --- AI CHATBOT & MULTI-PROVIDER AUTO-FALLBACK KEYS ---
# ═════════════════════════════════════════════════════════════════

# 1. Primary AI Provider: Google Gemini (Free & High Intelligence)
# Get Free Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Secondary AI Fallback: Groq Cloud (Ultra-Fast & High Free Tier Limit)
# Get Free Key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
